# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productivity_arcade?schema=public"

# Express API port.
PORT=4000

# Runtime environment: development | test | production
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Long random secrets for signing JWT cookies.
JWT_ACCESS_SECRET=replace-with-a-64-character-access-secret-change-before-production
JWT_REFRESH_SECRET=replace-with-a-64-character-refresh-secret-change-before-production

# Optional cookie domain. Leave empty for localhost.
COOKIE_DOMAIN=

# AWS region used for S3 and Bedrock.
AWS_REGION=us-east-1

# S3 bucket for production proof uploads.
AWS_S3_BUCKET=productivity-arcade-proof-media

# Amazon Bedrock model id for Claude 3.5 Sonnet.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# local = save uploads to backend/uploads
# s3 = upload proofs to AWS S3
STORAGE_DRIVER=local

# local = accept proof in local development
# bedrock = call Amazon Bedrock Claude
VERIFICATION_DRIVER=local

# Public backend URL used for generated media URLs.
API_PUBLIC_URL=http://localhost:4000

# Optional when not using AWS profiles or IAM roles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
